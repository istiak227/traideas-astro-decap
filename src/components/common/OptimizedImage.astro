---
import { Image } from "astro:assets";

const {
  src,
  alt = "",
  width = 1200,
  height = 800,
  loading = "lazy",
  decoding = "async",
  inferSize = true,
  layout = "constrained",
  ...attrs
} = Astro.props;
---
<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  inferSize={inferSize}
  layout={layout}
  {...attrs}
/>
