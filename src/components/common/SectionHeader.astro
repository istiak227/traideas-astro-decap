---
import Icon from "./Icon.astro";
const { eyebrow, title, description, action } = Astro.props;
---
<div class="block-head reveal">
  <div>
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h2 class="h-section" style="margin-top:14px" set:html={title}></h2>
  </div>
  {description && <p class="block-head-r">{description}</p>}
  {action && <a href={action.href} class="btn btn-ghost btn-arrow btn-sm" style="align-self:end">{action.label}</a>}
</div>
