  Sparkle: { size: 14, viewBox: "0 0 16 16", fill: "currentColor", paths: ['<path d="M8 0l1.2 5.3c.1.6.6 1.1 1.2 1.2L15 8l-4.6 1.5c-.6.2-1.1.7-1.2 1.2L8 16l-1.2-5.3c-.1-.5-.6-1-1.2-1.2L1 8l4.6-1.5c.6-.2 1.1-.7 1.2-1.2L8 0z" />'] },
  Linkedin: { size: 15, viewBox: "0 0 16 16", fill: "currentColor", paths: ['<path d="M3.2 4.6c0-.9.7-1.6 1.6-1.6s1.6.7 1.6 1.6S5.7 6.2 4.8 6.2 3.2 5.5 3.2 4.6zm.2 2.8h3V14h-3V7.4zM7.8 7.4h2.9v.9c.4-.6 1.2-1.1 2.3-1.1 2.2 0 2.6 1.4 2.6 3.3V14h-3v-2.9c0-.7-.1-1.7-1.2-1.7-1.2 0-1.3.9-1.3 1.7V14h-3V7.4z" />'] },
  Facebook: { size: 15, viewBox: "0 0 16 16", fill: "currentColor", paths: ['<path d="M9.5 14v-5.3H11l.3-2.2H9.5V5.2c0-.6.2-1.1 1-1.1h1V2.2h-1.6c-1.9 0-2.8 1.1-2.8 2.7v1.6H5.5v2.2h1.6V14h2.4z" />'] },
  X: { size: 13, viewBox: "0 0 16 16", fill: "currentColor", paths: ['<path d="M11.7 2h2.3l-5 5.7L15 14H10.5l-3.4-4.5L3.3 14H1l5.4-6.1L1 2h4.6l3 4.1L11.7 2zm-.8 10.7h1.3L5.2 3.3H3.8l7.1 9.4z" />'] },
