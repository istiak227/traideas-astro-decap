  Transform: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M21 9a8 8 0 00-13.6-3.2L5 8" />', '<path d="M5 4v4h4M7 19a8 8 0 0013.6 3.2L23 20" />', '<path d="M23 24v-4h-4" />'] },
  Product: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M14 4l9 5-9 5-9-5 9-5z" />', '<path d="M5 14l9 5 9-5M5 19l9 5 9-5" />'] },
  Consulting: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<circle cx="14" cy="14" r="9" />', '<path d="M14 9v5l3 2M8 22l-3 3M20 22l3 3" />'] },
  About: { size: 18, viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", strokeWidth: "1.5", paths: ['<circle cx="10" cy="6" r="3" />', '<path d="M4.5 17a5.5 5.5 0 0111 0" />'] },
  Moments: { size: 18, viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", strokeWidth: "1.5", paths: ['<rect x="3" y="4" width="14" height="12" rx="2" />', '<path d="M7 9l2 2 2.5-3 3.5 5H5l2-4z" />'] },
  Careers: { size: 18, viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", strokeWidth: "1.5", paths: ['<rect x="3" y="6" width="14" height="11" rx="2" />', '<path d="M7 6V4.5A1.5 1.5 0 018.5 3h3A1.5 1.5 0 0113 4.5V6M3 10h14" />'] }
};

icons.LinkedIn = icons.Linkedin;
icons.GitHub = icons.Github;

const icon = icons[name] ?? icons.Arrow;
const width = size ?? icon.size;
const strokeAttrs = icon.stroke
  ? `stroke="${icon.stroke}" stroke-width="${icon.strokeWidth}" stroke-linecap="round" stroke-linejoin="round"`
  : "";
const svg = `<svg width="${width}" height="${width}" viewBox="${icon.viewBox}" fill="${icon.fill}" ${strokeAttrs} aria-hidden="true" focusable="false">${icon.paths.join("")}</svg>`;
---
<span class:list={["icon", className]} set:html={svg}></span>
