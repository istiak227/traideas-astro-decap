  Mail: { size: 16, viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", strokeWidth: "1.5", paths: ['<rect x="3" y="4.5" width="14" height="11" rx="2" />', '<path d="M3.5 6l6.5 4.5L16.5 6" />'] },
