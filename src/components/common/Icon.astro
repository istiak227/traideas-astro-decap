  Health: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M14 23s-8-4.5-8-11a5 5 0 019-3 5 5 0 019 3c0 6.5-8 11-10 11z" />', '<path d="M10 13h2l1.5-3 1.5 4 1-2h2" />'] },
  Energy: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M16 3l-7 12h5l-2 10 8-13h-5l1-9z" />'] },
  Business: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<rect x="4" y="8" width="20" height="16" rx="1" />', '<path d="M10 8V5a1 1 0 011-1h6a1 1 0 011 1v3M4 14h20" />'] },
  Ecom: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M4 5h3l3 13h12l2-9H8" />', '<circle cx="11" cy="23" r="1.5" />', '<circle cx="20" cy="23" r="1.5" />'] },
  Startup: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M19 3l-10 13H14l-2 9 9-12h-5l3-10z" opacity=".5" />', '<path d="M6 22l2-2M4 18l2-2M10 26l1-1" />'] },
  Nonprofit: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M14 25s-9-5-9-13a6 6 0 019-4 6 6 0 019 4c0 8-9 13-9 13z" />'] },
  Govt: { size: 28, viewBox: "0 0 28 28", fill: "none", stroke: "currentColor", strokeWidth: "1.4", paths: ['<path d="M4 12L14 5l10 7" />', '<path d="M6 12v10h16V12M10 22v-6M14 22v-6M18 22v-6M4 24h20" />'] },
