---
import OptimizedImage from "./OptimizedImage.astro";

const { post, delay = "0s" } = Astro.props;
const href = post.href ?? `/insights/${post.slug}`;
---

<a href={href} class="blog-card reveal" style={`--delay:${delay}`}>
  <div class="b-thumb">
    <span class="b-tag">{post.cat}</span>
    <OptimizedImage src={post.image} alt={post.title} width={720} height={480} loading="lazy" />
  </div>
  <div class="b-body">
    <div class="b-meta">
      <span>{post.date}</span>
      <span class="dot"></span>
      {post.read && <span class="b-read">{post.read}</span>}
    </div>
    <h4>{post.title}</h4>
    <p>{post.excerpt}</p>
    <span class="b-link">Read more</span>
  </div>
</a>
