---
import { siteData } from "../../data/siteData.js";
import { serviceNav, companyNav } from "../../data/navData.js";
import Icon from "./Icon.astro";
const { pathname = "/" } = Astro.props;
const active = (href) => href === "/" ? pathname === "/" : pathname.startsWith(href);
const servicesOpen = active("/services");
const companyOpen = active("/about") || active("/moments") || active("/careers");
---
<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <img src={siteData.logo} alt="Traideas" class="brand-mark" width="36" height="36" />
      <span>{siteData.name}</span>
    </a>
    <ul class="nav-links">
      <li class="nav-item">
        <button class:list={["nav-trigger has-menu", active("/services") && "active"]} data-menu-toggle="services" aria-expanded="false">Services <span class="chev"><Icon name="Chevron" /></span></button>
        <div class="nav-menu nav-menu-services" data-menu-panel="services">
          {serviceNav.map((m) => <a href={m.href}><span class="mi-ico"><Icon name={m.icon} /></span><span><span class="mi-title">{m.label}</span></span></a>)}
        </div>
      </li>
      <li><a href="/case-studies" class:list={[active("/case-studies") && "active"]}>Case Studies</a></li>
      <li><a href="/insights" class:list={[active("/insights") && "active"]}>Insights</a></li>
      <li class="nav-item">
        <button class:list={["nav-trigger has-menu", (active("/about") || active("/moments") || active("/careers")) && "active"]} data-menu-toggle="company" aria-expanded="false">Traideas <span class="chev"><Icon name="Chevron" /></span></button>
        <div class="nav-menu nav-menu-company" data-menu-panel="company">
          {companyNav.map((m) => <a href={m.href}><span class="mi-ico"><Icon name={m.icon} /></span><span><span class="mi-title">{m.label}</span>{m.sub && <small>{m.sub}</small>}</span></a>)}
        </div>
      </li>
      <li><a href="/contact" class:list={[active("/contact") && "active"]}>Contact</a></li>
    </ul>
    <div class="nav-actions">
      <a href="/contact" class="btn btn-primary btn-sm schedule-btn"><Icon name="Calendar" size={16} />Schedule a Call</a>
      <button class="mobile-toggle" data-mobile-toggle aria-label="Open menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" /></svg>
      </button>
    </div>
  </div>
</nav>
<div class="mobile-drawer" data-mobile-drawer aria-hidden="true">
  <div class="mobile-drawer-inner">
    <ul class="mobile-nav-list">
      <li class:list={["mobile-nav-group", servicesOpen && "open"]}>
        <button class="mobile-nav-group-trigger" type="button" data-mobile-nav-toggle aria-expanded={String(servicesOpen)}>
          <span>Services</span>
          <span class="chev"><Icon name="Chevron" /></span>
        </button>
        <div class="mobile-nav-submenu">
          {serviceNav.map((m) => <a href={m.href}><span class="mi-ico"><Icon name={m.icon} size={16} /></span>{m.label}</a>)}
        </div>
      </li>
      <li><a href="/case-studies" class="mobile-nav-link">Case Studies</a></li>
      <li><a href="/insights" class="mobile-nav-link">Insights</a></li>
      <li class:list={["mobile-nav-group", companyOpen && "open"]}>
        <button class="mobile-nav-group-trigger" type="button" data-mobile-nav-toggle aria-expanded={String(companyOpen)}>
          <span>Traideas</span>
          <span class="chev"><Icon name="Chevron" /></span>
        </button>
        <div class="mobile-nav-submenu">
          {companyNav.map((m) => <a href={m.href}><span class="mi-ico"><Icon name={m.icon} size={16} /></span>{m.label}</a>)}
        </div>
      </li>
      <li><a href="/contact" class="mobile-nav-link">Contact</a></li>
    </ul>
    <div class="mobile-drawer-cta">
      <a href="/contact" class="btn btn-primary mobile-schedule-btn" style="width:100%;justify-content:center"><Icon name="Calendar" size={16} />Schedule a Call</a>
    </div>
  </div>
</div>
<div class="mobile-overlay" data-mobile-overlay aria-hidden="true"></div>
