---
const { name } = Astro.props;

const icons = {
  React: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="2.5" fill="#61dafb"/><g fill="none" stroke="#61dafb" stroke-width="1.3"><ellipse cx="16" cy="16" rx="10" ry="4"/><ellipse cx="16" cy="16" rx="10" ry="4" transform="rotate(60 16 16)"/><ellipse cx="16" cy="16" rx="10" ry="4" transform="rotate(120 16 16)"/></g></svg>`,
  "Next.js": `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="#000"/><text x="16" y="21" text-anchor="middle" fill="white" font-family="Satoshi, system-ui, sans-serif" font-weight="900" font-size="14">N</text></svg>`,
  "Node.js": `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><polygon points="16,3 28,10 28,22 16,29 4,22 4,10" fill="none" stroke="#8cc84b" stroke-width="1.8"/><text x="16" y="20" text-anchor="middle" fill="#8cc84b" font-family="Satoshi, system-ui, sans-serif" font-weight="900" font-size="10">JS</text></svg>`,
  Python: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><rect x="8" y="6" width="16" height="10" rx="3" fill="#3776ab"/><rect x="8" y="16" width="16" height="10" rx="3" fill="#ffd43b"/><circle cx="12" cy="10" r="1.3" fill="white"/><circle cx="20" cy="22" r="1.3" fill="#3776ab"/></svg>`,
  Flutter: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><path d="M21 4L6 19l5 5 20-20H21z" fill="#54c5f8"/><path d="M16 18l-5 5 5 5 5-5-5-5z" fill="#01579b"/></svg>`,
  JavaScript: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="4" fill="#f7df1e"/><text x="16" y="22" text-anchor="middle" font-family="Satoshi, system-ui, sans-serif" font-weight="900" font-size="13">JS</text></svg>`,
  Shopify: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><path d="M23 9c-.3-.2-2-1.5-3.5-1.5 0 0-1.6-.2-2.4.5-.9-.8-2.1-.5-2.1-.5-.4-.2-1-.5-1-.5L10 27l15 2 2-17s-3.7-2.8-4-3z" fill="#95bf47"/><text x="17" y="22" text-anchor="middle" fill="white" font-family="Satoshi, system-ui, sans-serif" font-weight="900" font-size="10">S</text></svg>`,
  Strapi: `<svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="5" width="22" height="22" rx="3" fill="#4945ff"/><rect x="10" y="10" width="12" height="12" fill="white" opacity=".25"/><rect x="14" y="14" width="8" height="8" fill="white"/></svg>`
};
---
<span class="tech-logo" set:html={icons[name] ?? icons.React}></span>
