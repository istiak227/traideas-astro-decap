---
import MainLayout from "../layouts/MainLayout.astro";
import { getContactPageData } from "../lib/content.js";
import Icon from "../components/common/Icon.astro";
const contactData = await getContactPageData();
---
<MainLayout title={contactData.seo?.title} description={contactData.seo?.description}>
  <section class="contact-hero"><div class="ch-bg-grid"></div><div class="ch-blob"></div><div class="container ch-grid"><div class="ch-left reveal in"><div class="eyebrow">{contactData.hero.eyebrow}</div><h1 class="h-display ch-h1" set:html={contactData.hero.title.replace("digital system", '<span class="serif-italic">digital system</span>')}></h1><p class="lead ch-sub">{contactData.hero.subtitle}</p><div class="ch-highlights">{contactData.highlights.map((h) => <div class="ch-pill"><span class="ch-pill-ico">{h.icon}</span><span>{h.label}</span></div>)}</div><div class="ch-contact-list"><a href={`mailto:${contactData.email}`} class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Mail" /></span><span><span class="ch-cr-label">Email</span><span class="ch-cr-val">{contactData.email}</span></span></a><a href={`tel:${contactData.phone.replaceAll(" ", "")}`} class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Phone" /></span><span><span class="ch-cr-label">Phone</span><span class="ch-cr-val">{contactData.phone}</span></span></a><div class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Clock" /></span><span><span class="ch-cr-label">Working hours</span><span class="ch-cr-val">{contactData.workingHours}</span></span></div></div></div><div class="ch-right reveal in" id="calendly"><div class="ch-cal-frame"><div class="ch-cal-head"><span class="ch-cal-dot"></span><span class="ch-cal-title">{contactData.calendarTitle}</span><span class="ch-cal-tag">{contactData.calendarTag}</span></div><div class="calendly-inline-widget" data-url={`${contactData.calendlyUrl}?hide_gdpr_banner=1`} style="min-width:320px;height:700px;"></div><script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script></div></div></div></section>
  <section class="block contact-locations"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">{contactData.locationsIntro.eyebrow}</div><h2 class="h-section" style="margin-top:14px" set:html={contactData.locationsIntro.title}></h2></div><p class="block-head-r">{contactData.locationsIntro.description}</p></div><div class="contact-locations-grid">{contactData.offices.map((o, i) => <div class="contact-location-card reveal" style={`--delay:${i * 0.08}s`}><div class="cl-media"><img src={o.image} alt={o.title} loading="lazy" /><div class="cl-media-grad"></div><span class="cl-tag">{o.tag}</span></div><div class="cl-body"><h3 class="cl-name">{o.title}</h3><div class="cl-row"><span class="cl-row-ico"><Icon name="MapPin" /></span><p class="cl-addr">{o.address}</p></div><a href={o.mapUrl} target="_blank" rel="noreferrer" class="btn btn-ghost btn-arrow btn-sm cl-cta">Get Directions</a></div></div>)}</div><div class="contact-map reveal"><div class="cm-frame"><iframe src="https://maps.google.com/maps?q=Traideas%20Narayanganj&t=&z=17&ie=UTF8&iwloc=&output=embed" width="100%" height="420" style="border:0" loading="lazy" title="Traideas on Google Maps"></iframe></div></div></div></section>
  <section class="service-cta contact-cta reveal"><div class="sct-inner"><div><div class="eyebrow">{contactData.directCta.eyebrow}</div><h2 style="margin-top:14px" set:html={contactData.directCta.title}></h2><p>{contactData.directCta.description}</p><div class="sct-actions">{contactData.directCta.actions.map((action) => <a href={action.href} class:list={["btn", action.style === "primary" ? "btn-primary" : "btn-ghost btn-arrow"]}><Icon name="Calendar" size={15} />{action.label}</a>)}</div></div><div class="sct-aside"><h5>{contactData.directCta.asideTitle}</h5><ul>{contactData.directCta.items.map((item) => <li>{item}</li>)}</ul></div></div></section>
</MainLayout>
