---
import MainLayout from "../layouts/MainLayout.astro";
import { contactData } from "../data/contactData.js";
import { siteData } from "../data/siteData.js";
import { seoData } from "../data/seoData.js";
import Icon from "../components/common/Icon.astro";
const contactHighlights = [
  { label: "Enterprise Software", icon: "◇" },
  { label: "AI Automation", icon: "✧" },
  { label: "Digital Transformation", icon: "↻" },
  { label: "Technical Consulting", icon: "◎" }
];
---
<MainLayout title={seoData.pages.contact.title} description={seoData.pages.contact.description}>
  <section class="contact-hero"><div class="ch-bg-grid"></div><div class="ch-blob"></div><div class="container ch-grid"><div class="ch-left reveal in"><div class="eyebrow">{contactData.hero.eyebrow}</div><h1 class="h-display ch-h1">Let's build your next<br /><span class="serif-italic">digital system</span> together.</h1><p class="lead ch-sub">{contactData.hero.subtitle}</p><div class="ch-highlights">{contactHighlights.map((h) => <div class="ch-pill"><span class="ch-pill-ico">{h.icon}</span><span>{h.label}</span></div>)}</div><div class="ch-contact-list"><a href={`mailto:${siteData.email}`} class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Mail" /></span><span><span class="ch-cr-label">Email</span><span class="ch-cr-val">{siteData.email}</span></span></a><a href={`tel:${siteData.phone.replaceAll(" ", "")}`} class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Phone" /></span><span><span class="ch-cr-label">Phone</span><span class="ch-cr-val">{siteData.phone}</span></span></a><div class="ch-contact-row"><span class="ch-cr-ico"><Icon name="Clock" /></span><span><span class="ch-cr-label">Working hours</span><span class="ch-cr-val">Sun – Thu · 09:00 AM – 7:00 PM (GMT+6)</span></span></div></div></div><div class="ch-right reveal in" id="calendly"><div class="ch-cal-frame"><div class="ch-cal-head"><span class="ch-cal-dot"></span><span class="ch-cal-title">Schedule a 30-min intro call</span><span class="ch-cal-tag">Free</span></div><div class="calendly-inline-widget" data-url="https://calendly.com/traideas/15?hide_gdpr_banner=1" style="min-width:320px;height:700px;"></div><script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script></div></div></div></section>
  <section class="block contact-locations"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Find us</div><h2 class="h-section" style="margin-top:14px">Visit our <span class="serif-italic">offices.</span></h2></div><p class="block-head-r">Traideas operates from Narayanganj and Dhaka, supporting clients locally and internationally across enterprise, government, and startup mandates.</p></div><div class="contact-locations-grid">{contactData.offices.map((o, i) => <div class="contact-location-card reveal" style={`--delay:${i * 0.08}s`}><div class="cl-media"><img src={o.image} alt={o.title} loading="lazy" /><div class="cl-media-grad"></div><span class="cl-tag">{o.tag}</span></div><div class="cl-body"><h3 class="cl-name">{o.title}</h3><div class="cl-row"><span class="cl-row-ico"><Icon name="MapPin" /></span><p class="cl-addr">{o.address}</p></div><a href={o.mapUrl} target="_blank" rel="noreferrer" class="btn btn-ghost btn-arrow btn-sm cl-cta">Get Directions</a></div></div>)}</div><div class="contact-map reveal"><div class="cm-frame"><iframe src="https://maps.google.com/maps?q=Traideas%20Narayanganj&t=&z=17&ie=UTF8&iwloc=&output=embed" width="100%" height="420" style="border:0" loading="lazy" title="Traideas on Google Maps"></iframe></div></div></div></section>
  <section class="service-cta contact-cta reveal"><div class="sct-inner"><div><div class="eyebrow">Have a project in mind?</div><h2 style="margin-top:14px">Share your idea, we'll help you<br /><span class="it">define the path.</span></h2><p>Tell us about your goals, constraints, and timeline. We'll reply within one business day with a structured response and a recommended next step.</p><div class="sct-actions"><a href="#calendly" class="btn btn-primary"><Icon name="Calendar" size={15} />Schedule a Call</a><a href="/case-studies" class="btn btn-ghost btn-arrow">View Our Work</a></div></div><div class="sct-aside"><h5>What happens next</h5><ul><li>30-minute discovery call within 48 hours</li><li>NDA signed before any specifics shared</li><li>Written scope &amp; estimate delivered in 5 business days</li><li>Direct line to founders, no account managers</li></ul></div></div></section>
</MainLayout>
