---
import MainLayout from "../../layouts/MainLayout.astro";
import { caseStudies } from "../../data/caseStudiesData.js";
export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}
const { cs } = Astro.props;
---
<MainLayout title={`${cs.title} | Traideas`} description={cs.summary}>
  <section class="service-hero" style="padding:80px 0 90px"><div class="sh-bg"></div><div class="sh-blob"></div><div class="container"><div class="sh-grid"><div class="reveal in"><div class="sh-crumb"><a href="/case-studies">Case Studies</a><span>/</span><span>{cs.shortTitle}</span></div><div style="display:flex;gap:7px;margin-bottom:16px;flex-wrap:wrap"><span style="padding:4px 10px;border-radius:999px;background:var(--brand-tint-2);color:var(--brand-ink);font-size:11px;font-weight:600">{cs.industry}</span><span style="padding:4px 10px;border-radius:999px;background:var(--mist);color:var(--graphite);font-size:11px;font-weight:600">{cs.location}</span></div><h1 class="h-display" style="margin-bottom:22px">{cs.shortTitle}<span class="it" style="display:block;color:var(--brand-ink)">{cs.title.replace(cs.shortTitle, "").trim()}</span></h1><p style="font-size:18px;line-height:1.6;color:var(--graphite);max-width:50ch;margin:0 0 28px">{cs.summary}</p><div class="sh-ctas"><a href="/contact" class="btn btn-primary btn-arrow">{cs.cta.label}</a><a href="/case-studies" class="btn btn-ghost">All Case Studies</a></div></div><div class="sh-visual reveal in"><span class="sv-eyebrow">{cs.clientShort}</span><div class="sv-stat-list"><div><strong>{cs.industry}</strong><span>Industry</span></div><div><strong>{cs.location}</strong><span>Location</span></div></div><div class="sv-tags">{cs.techStack.map((t) => <span>{t}</span>)}</div></div></div></div></section>
  <section class="service-about" style="border-top:1px solid var(--hair)"><div class="container sa-grid"><div><div class="eyebrow reveal">Project Overview</div><h2 class="h-section reveal" style="margin-top:14px;margin-bottom:22px">What we <span class="serif-italic">built and why.</span></h2><p class="reveal detail-rich">{cs.overview}</p><div class="sv-tags reveal">{cs.techStack.map((t) => <span>{t}</span>)}</div></div><div class="sa-features">{cs.serviceComponents.map((item, i) => <div class="sa-feat reveal" style={`--delay:${i * 0.06}s`}><div class="sa-ico">◇</div><div><h4>{item}</h4><p>Delivered as part of the project scope for {cs.clientShort}.</p></div></div>)}</div></div></section>
  <section class="service-components"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Challenge & Solution</div><h2 class="h-section" style="margin-top:14px">From friction to <span class="serif-italic">working system.</span></h2></div></div><div class="sc-grid">{[...cs.challenge.map((t) => ({ t, kind: "Challenge" })), ...cs.solution.map((t) => ({ t, kind: "Solution" }))].map((item) => <div class="sc-card reveal"><div class="sc-ico">{item.kind === "Challenge" ? "!" : "✓"}</div><h4>{item.t}</h4><p>{item.kind}</p></div>)}</div></div></section>
  {cs.impactStats.length > 0 && <section class="service-impact"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Impact</div><h2 class="h-section" style="margin-top:14px">Measured <span class="serif-italic">outcomes.</span></h2></div></div><div class="si-grid">{cs.impactStats.map((k) => <div class="si-card reveal"><div class="si-num">{k.v}<small>{k.s}</small></div><h4>{k.t}</h4><p>{k.d}</p></div>)}</div></div></section>}
</MainLayout>
