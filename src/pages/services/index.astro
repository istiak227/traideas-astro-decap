---
import MainLayout from "../../layouts/MainLayout.astro";
import ServicesSection from "../../components/home/ServicesSection.astro";
import CTASection from "../../components/home/CTASection.astro";
import Icon from "../../components/common/Icon.astro";
import { seoData } from "../../data/seoData.js";
---
<MainLayout title={seoData.pages.services.title} description={seoData.pages.services.description}>
  <section class="service-hero"><div class="sh-bg"></div><div class="sh-blob"></div><div class="container"><div class="sh-grid"><div class="reveal in"><div class="eyebrow">Services</div><h1>Four disciplines,<br /><span class="it">one delivery partner.</span></h1><p class="sh-sub">Explore Traideas services across transformation, MVP development, AI automation, and technology consulting.</p><div class="sh-ctas"><a href="/contact" class="btn btn-primary"><Icon name="Calendar" size={15} />Schedule a Call</a><a href="/case-studies" class="btn btn-ghost btn-arrow">View Our Work</a></div></div><div class="sh-visual services-index-visual reveal in"><div class="sv-head"><span class="sv-eyebrow services-index-eyebrow">Traideas services</span><span class="sv-code">SVC / ALL</span></div><h3 style="font-family:var(--display);font-weight:700;font-size:24px;letter-spacing:-0.02em;line-height:1.15;margin:24px 0 8px">Full-cycle delivery, <span class="serif-italic" style="color:var(--brand-ink)">scoped</span> around outcomes.</h3><p class="sv-copy">Senior engineers, product thinking, and dependable execution across the full software lifecycle.</p><div class="sv-stat-list"><div><strong>4</strong><span>Core services</span></div><div><strong>100+</strong><span>Projects delivered</span></div><div><strong>5+ yr</strong><span>Delivery experience</span></div><div><strong>10+</strong><span>Countries served</span></div></div><div class="sv-tags services-index-tags">{["Digital transformation", "MVP development", "AI automation", "Consulting"].map((tag) => <span>{tag}</span>)}</div><div class="sv-bottom services-index-bottom"><span class="pulse">Service squads available</span><span>Discovery in 48 hours</span></div></div></div></div></section>
  <ServicesSection />
  <CTASection />
</MainLayout>
