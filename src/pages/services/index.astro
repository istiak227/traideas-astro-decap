---
import MainLayout from "../../layouts/MainLayout.astro";
import ServicesSection from "../../components/home/ServicesSection.astro";
import CTASection from "../../components/home/CTASection.astro";
import Icon from "../../components/common/Icon.astro";
import { getServices, getServicesPageData } from "../../lib/content.js";
const [page, services] = await Promise.all([getServicesPageData(), getServices()]);
---
<MainLayout title={page.seo?.title} description={page.seo?.description}>
  <section class="service-hero"><div class="sh-bg"></div><div class="sh-blob"></div><div class="container"><div class="sh-grid"><div class="reveal in"><div class="eyebrow">{page.hero.eyebrow}</div><h1>{page.hero.title}<br /><span class="it">{page.hero.accent}</span></h1><p class="sh-sub">{page.hero.subtitle}</p><div class="sh-ctas"><a href={page.hero.primaryCta.href} class="btn btn-primary"><Icon name="Calendar" size={15} />{page.hero.primaryCta.label}</a><a href={page.hero.secondaryCta.href} class="btn btn-ghost btn-arrow">{page.hero.secondaryCta.label}</a></div></div><div class="sh-visual services-index-visual reveal in"><div class="sv-head"><span class="sv-eyebrow services-index-eyebrow">{page.visual.eyebrow}</span><span class="sv-code">{page.visual.code}</span></div><h3 style="font-family:var(--display);font-weight:700;font-size:24px;letter-spacing:-0.02em;line-height:1.15;margin:24px 0 8px" set:html={page.visual.title}></h3><p class="sv-copy">{page.visual.description}</p><div class="sv-stat-list">{page.visual.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div><div class="sv-tags services-index-tags">{page.visual.tags.map((tag) => <span>{tag}</span>)}</div><div class="sv-bottom services-index-bottom"><span class="pulse">{page.visual.bottomLeft}</span><span>{page.visual.bottomRight}</span></div></div></div></div></section>
  <ServicesSection services={services} section={page.servicesSection} />
  <CTASection cta={page.cta} />
</MainLayout>
