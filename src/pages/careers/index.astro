---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCareersPageData } from "../../lib/content.js";
import Icon from "../../components/common/Icon.astro";
const careersData = await getCareersPageData();
---
<MainLayout title={careersData.seo?.title} description={careersData.seo?.description}>
  <section class="careers-hero"><div class="ch-bg-grid"></div><div class="ch-blob"></div><div class="container ch-grid"><div class="ch-left reveal in"><div class="eyebrow">{careersData.hero.eyebrow}</div><h1 class="h-display ch-h1">Build the Future<br />With <span class="serif-italic">Traideas.</span></h1><p class="lead ch-sub">{careersData.hero.subtitle}</p><div class="ch-ctas"><a href="#openings" class="btn btn-primary btn-arrow">View Open Positions</a><a href="mailto:hr@traideas.com" class="btn btn-ghost">Send Resume <Icon name="ArrowUpRight" size={13} /></a></div><div class="ch-meta">{careersData.hero.meta.map((m) => <div class="ch-meta-item"><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>)}</div></div><div class="ch-right reveal in"><div class="ch-img-wrap"><img src={careersData.hero.image} alt="Life at Traideas" /><span class="ch-img-tag">We're hiring</span></div></div></div></section>
  <section class="careers-why"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Why join us</div><h2 class="h-section" style="margin-top:14px">Why Join <span class="serif-italic">Traideas.</span></h2></div><p class="block-head-r">We pair early-career engineers with senior mentors on production systems that ship — not on toy projects in a sandbox.</p></div><div class="careers-why-grid">{careersData.reasons.map((r, i) => <div class="cwj-card reveal" style={`--delay:${i * 0.06}s`}><div class="cwj-num">{r.n}</div><h3 class="cwj-title">{r.t}</h3><p class="cwj-desc">{r.d}</p></div>)}</div></div></section>
  <section class="careers-life"><div class="container"><div class="careers-life-grid"><div class="cl-text reveal"><div class="eyebrow">Life at Traideas</div><h2 class="h-section" style="margin-top:14px">We grow <span class="serif-italic">together.</span></h2><p class="lead">At Traideas, we believe technology grows faster when people grow together.</p><p class="body">Our team works on meaningful platforms used by ministries, enterprises, and international organizations. Every engineer here ships code that's running in production within their first 30 days — and reviews from a senior architect by week two.</p><div class="cl-values">{careersData.values.map((v) => <span class="cl-value-chip"><span class="dot">{v.icon}</span><span>{v.label}</span></span>)}</div></div><div class="cl-collage reveal">{careersData.lifeImages.map((image) => <div class={`cl-tile ${image.cls}`}><img src={image.src} alt={image.alt} loading="lazy" /></div>)}</div></div></div></section>
  <section class="careers-jobs" id="openings"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Open positions</div><h2 class="h-section" style="margin-top:14px">Open <span class="serif-italic">Positions.</span></h2></div><p class="block-head-r">Active roles below. Don't see a fit? Send your resume — we review every inbound application.</p></div><div class="cj-list">{careersData.jobs.map((job) => <div class="cj-card reveal" data-career-card data-open="false"><div class="cj-row"><div class="cj-left"><h3 class="cj-role">{job.role}</h3><div class="cj-loc"><span class="ico"><Icon name="MapPin" size={12} /></span><span>{job.loc}</span></div><div class="cj-tags">{job.tags.map((t) => <span class="cj-tag">#{t}</span>)}</div></div><div class="cj-right"><a href={job.applyUrl} target="_blank" rel="noreferrer" class="btn btn-primary btn-arrow cj-apply">Apply Now</a><button class="cj-detail-toggle" type="button" aria-expanded="false" data-career-toggle>View Details <span class="chev"><Icon name="Chevron" size={11} /></span></button></div></div><div class="cj-detail" aria-hidden="true"><div class="cj-detail-inner"><div class="cj-detail-grid"><div class="cj-block"><h4 class="cj-block-h">Skills Required</h4><ul>{job.skills.map((s) => <li>{s}</li>)}</ul></div><div class="cj-block"><h4 class="cj-block-h">Internship Benefits</h4><ul>{job.benefits.map((b) => <li>{b}</li>)}</ul></div></div>{job.detail && <div class="cj-detail-prose">{job.detail}</div>}</div></div></div>)}</div></div></section>
  <section class="careers-cta"><div class="container"><div class="careers-cta-card reveal"><div class="eyebrow">General application</div><h2>Didn't find a role that<br />matches your <span class="it">profile?</span></h2><p>We are always looking for passionate engineers, designers, and innovators to join Traideas. Send us your resume and we'll get back to you within one business week.</p><div class="ccta-actions"><a href="mailto:hr@traideas.com" class="btn btn-primary">Send Your Resume <Icon name="ArrowUpRight" size={13} /></a></div><div class="ccta-mail">or email us directly at <a href="mailto:hr@traideas.com">hr@traideas.com</a></div></div></div></section>
  <script is:inline>
    document.querySelectorAll("[data-career-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const card = toggle.closest("[data-career-card]");
        const detail = card?.querySelector(".cj-detail");
        const open = card?.dataset.open !== "true";
        card.dataset.open = String(open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.childNodes[0].textContent = open ? "Hide Details " : "View Details ";
        detail?.setAttribute("aria-hidden", String(!open));
      });
    });
  </script>
</MainLayout>
