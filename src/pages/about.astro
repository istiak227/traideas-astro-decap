---
import MainLayout from "../layouts/MainLayout.astro";
import CultureSection from "../components/home/CultureSection.astro";
import { aboutData } from "../data/aboutData.js";
import { seoData } from "../data/seoData.js";
import { siteData } from "../data/siteData.js";
import Icon from "../components/common/Icon.astro";
---
<MainLayout title={seoData.pages.about.title} description={seoData.pages.about.description}>
  <section class="moments-hero"><div class="hero-bg-grid"></div><div class="hero-blob"></div><div class="container mh-grid"><div class="mh-left reveal in"><div class="eyebrow">{aboutData.hero.eyebrow}</div><h1 class="h-display" style="margin-top:18px">{aboutData.hero.title.replace("Working Systems.", "")}<br /><span class="accent">Working Systems.</span></h1><p class="mh-sub">{aboutData.hero.subtitle}</p><div class="mh-ctas"><a href="/contact" class="btn btn-primary"><Icon name="Calendar" size={15} />Schedule a Call</a><a href={siteData.companyProfileUrl} target="_blank" rel="noreferrer" download class="btn btn-ghost" aria-label="Download Traideas company profile PDF"><Icon name="Download" size={15} />Download Company Profile</a></div><div class="mh-meta">{aboutData.hero.meta.map((m) => <div class="mh-meta-item"><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>)}</div></div><div class="mh-right reveal in"><div class="about-hero-img"><img src={aboutData.hero.image} alt="The Traideas team at work" /><div class="about-hero-chip"><span class="dot"></span> Five years building national-scale systems</div></div></div></div></section>
  <section class="about-story"><div class="container story-grid"><div class="story-visual reveal"><div class="story-visual-img"><img src={aboutData.story.image} alt="Engineering floor at Traideas" loading="lazy" /></div><div class="story-stat"><div class="stat-num">2021</div><div class="stat-lbl">Founded — building working systems ever since</div></div></div><div class="story-copy reveal"><div class="eyebrow">{aboutData.story.eyebrow}</div><h2 class="h-section" style="margin-top:12px">From an idea to a <span class="serif-italic">working system.</span></h2><p>Traideas began its journey in <strong>2021</strong> with a vision to make technology more practical, scalable, and meaningful for organizations solving real-world challenges.</p><p>The name <strong>Traideas</strong> was formed by merging two words — <em class="serif-italic">Trade</em> and <em class="serif-italic">Ideas</em> — representing our belief that innovation becomes powerful when ideas are transformed into working systems.</p><p>Since then, we have partnered with government institutions, enterprises, and international organizations to design and deliver digital platforms that improve transparency, efficiency, and service delivery.</p></div></div></section>
  <section class="about-mindset"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">Our mindset</div><h2 class="h-section" style="margin-top:14px">Three principles, <span class="serif-italic">one outcome.</span></h2></div><p class="block-head-r">The operating principles we apply to every engagement — from a ministry-scale platform to a startup MVP.</p></div><div class="mindset-grid">{aboutData.pillars.map((p, i) => <div class="mindset-card reveal" style={`--delay:${i * 0.07}s`}><div class="ms-num">{p.n} / 03</div><div class="ms-ico">{i === 0 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="9" height="9" rx="1.5"></rect><rect x="15" y="4" width="9" height="9" rx="1.5"></rect><rect x="4" y="15" width="9" height="9" rx="1.5"></rect><rect x="15" y="15" width="9" height="9" rx="1.5"></rect><path d="M13 8.5h2M13 19.5h2M8.5 13v2M19.5 13v2" stroke-dasharray="1.5 1.5"></path></svg>}{i === 1 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l9 4v6c0 5.5-3.8 10.3-9 12-5.2-1.7-9-6.5-9-12V7l9-4z"></path><path d="M9.5 14l3 3 6-6"></path></svg>}{i === 2 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22l5-5 4 4 11-11"></path><path d="M17 10h7v7"></path></svg>}</div><h3>{p.t}</h3><p>{p.d}</p></div>)}</div></div></section>
  <section class="about-award"><div class="container"><div class="award-grid"><div class="award-visual reveal"><div class="award-img"><img src={aboutData.award.image} alt="Best Public Service Innovation Award" loading="lazy" /></div><div class="award-badge">National Recognition</div></div><div class="award-copy reveal"><h2 class="h-section">Recognized for <span class="serif-italic">Public Service Innovation.</span></h2><p>Traideas received the <strong>Best Public Service Innovation Award</strong> for developing the Consumer Complaint Management System (CCMS) for the Directorate of National Consumer Rights Protection under the Ministry of Commerce.</p><p>The platform transformed how consumer complaints are submitted, tracked, and resolved nationwide — improving transparency and accessibility for citizens.</p><div class="award-meta">{aboutData.award.meta.map((m) => <div class="award-meta-item"><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>)}</div></div></div></div></section>
  <div class="about-culture"><CultureSection /></div>
  <section class="service-cta" id="about-join"><div class="sct-inner reveal"><div><div class="eyebrow">Careers at Traideas</div><h2 style="margin-top:14px">Build the Future <span class="it">with us.</span></h2><p>We are always looking for curious minds and passionate builders ready to solve meaningful problems — across engineering, design, and AI.</p><div class="sct-actions"><a href="/careers" class="btn btn-primary">View Open Positions</a><a href="/contact" class="btn btn-ghost"><Icon name="Calendar" size={15} />Schedule a Call</a></div></div><div class="sct-aside"><h5>Why Traideas</h5><ul><li>Government-grade platforms with national impact</li><li>Senior engineers, low-ego, deep autonomy</li><li>Hybrid working from Dhaka · Narayanganj</li><li>Mentorship across product, AI &amp; engineering</li><li>Making technology work for you</li></ul></div></div></section>
</MainLayout>
