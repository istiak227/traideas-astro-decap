---
import MainLayout from "../layouts/MainLayout.astro";
import CultureSection from "../components/home/CultureSection.astro";
import { getAboutPageData } from "../lib/content.js";
import { siteData } from "../data/siteData.js";
import Icon from "../components/common/Icon.astro";
import OptimizedImage from "../components/common/OptimizedImage.astro";

const aboutData = await getAboutPageData();
---
<MainLayout title={aboutData.seo?.title} description={aboutData.seo?.description}>
  <section class="moments-hero"><div class="hero-bg-grid"></div><div class="hero-blob"></div><div class="container mh-grid"><div class="mh-left reveal in"><div class="eyebrow">{aboutData.hero.eyebrow}</div><h1 class="h-display" style="margin-top:18px">{aboutData.hero.title.replace("Working Systems.", "")}<br /><span class="accent">Working Systems.</span></h1><p class="mh-sub">{aboutData.hero.subtitle}</p><div class="mh-ctas"><a href="/contact" class="btn btn-primary"><Icon name="Calendar" size={15} />Schedule a Call</a><a href={siteData.companyProfileUrl} target="_blank" rel="noreferrer" download class="btn btn-ghost" aria-label="Download Traideas company profile PDF"><Icon name="Download" size={15} />Download Company Profile</a></div><div class="mh-meta">{aboutData.hero.meta.map((m) => <div class="mh-meta-item"><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>)}</div></div><div class="mh-right reveal in"><div class="about-hero-img"><OptimizedImage src={aboutData.hero.image} alt="The Traideas team at work" width={900} height={700} loading="eager" /><div class="about-hero-chip"><span class="dot"></span> Five years building national-scale systems</div></div></div></div></section>
  <section class="about-story"><div class="container story-grid"><div class="story-visual reveal"><div class="story-visual-img"><OptimizedImage src={aboutData.story.image} alt="Engineering floor at Traideas" width={900} height={700} loading="lazy" /></div><div class="story-stat"><div class="stat-num">{aboutData.storyStat.value}</div><div class="stat-lbl">{aboutData.storyStat.label}</div></div></div><div class="story-copy reveal"><div class="eyebrow">{aboutData.story.eyebrow}</div><h2 class="h-section" style="margin-top:12px">From an idea to a <span class="serif-italic">working system.</span></h2>{aboutData.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
  <section class="about-mindset"><div class="container"><div class="block-head reveal"><div><div class="eyebrow">{aboutData.mindsetIntro.eyebrow}</div><h2 class="h-section" style="margin-top:14px" set:html={aboutData.mindsetIntro.title}></h2></div><p class="block-head-r">{aboutData.mindsetIntro.description}</p></div><div class="mindset-grid">{aboutData.pillars.map((p, i) => <div class="mindset-card reveal" style={`--delay:${i * 0.07}s`}><div class="ms-num">{p.n} / 03</div><div class="ms-ico">{i === 0 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="9" height="9" rx="1.5"></rect><rect x="15" y="4" width="9" height="9" rx="1.5"></rect><rect x="4" y="15" width="9" height="9" rx="1.5"></rect><rect x="15" y="15" width="9" height="9" rx="1.5"></rect><path d="M13 8.5h2M13 19.5h2M8.5 13v2M19.5 13v2" stroke-dasharray="1.5 1.5"></path></svg>}{i === 1 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l9 4v6c0 5.5-3.8 10.3-9 12-5.2-1.7-9-6.5-9-12V7l9-4z"></path><path d="M9.5 14l3 3 6-6"></path></svg>}{i === 2 && <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22l5-5 4 4 11-11"></path><path d="M17 10h7v7"></path></svg>}</div><h3>{p.t}</h3><p>{p.d}</p></div>)}</div></div></section>
  <section class="about-award"><div class="container"><div class="award-grid"><div class="award-visual reveal"><div class="award-img"><OptimizedImage src={aboutData.award.image} alt="Best Public Service Innovation Award" width={900} height={700} loading="lazy" /></div><div class="award-badge">National Recognition</div></div><div class="award-copy reveal"><h2 class="h-section">{aboutData.award.title}</h2>{aboutData.award.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<div class="award-meta">{aboutData.award.meta.map((m) => <div class="award-meta-item"><div class="lbl">{m.label}</div><div class="val">{m.value}</div></div>)}</div></div></div></div></section>
  <div class="about-culture"><CultureSection /></div>
  <section class="service-cta" id="about-join"><div class="sct-inner reveal"><div><div class="eyebrow">{aboutData.joinCta.eyebrow}</div><h2 style="margin-top:14px" set:html={aboutData.joinCta.title}></h2><p>{aboutData.joinCta.description}</p><div class="sct-actions"><a href={aboutData.joinCta.primary.href} class="btn btn-primary">{aboutData.joinCta.primary.label}</a><a href={aboutData.joinCta.secondary.href} class="btn btn-ghost"><Icon name="Calendar" size={15} />{aboutData.joinCta.secondary.label}</a></div></div><div class="sct-aside"><h5>{aboutData.joinCta.asideTitle}</h5><ul>{aboutData.joinCta.items.map((item) => <li>{item}</li>)}</ul></div></div></section>
</MainLayout>
