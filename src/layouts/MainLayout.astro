---
import "../styles/global.css";
import SEO from "../components/common/SEO.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import WhatsAppButton from "../components/common/WhatsAppButton.astro";
import { seoData } from "../data/seoData.js";
const { title, description, image, hideFooter = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/images/logo.png" />
    <SEO title={title || seoData.default.title} description={description || seoData.default.description} image={image} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LPP4YRQKP4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LPP4YRQKP4');
    </script>
  </head>
  <body>
    <Header pathname={Astro.url.pathname} />
    <slot />
    {!hideFooter && <Footer />}
    <WhatsAppButton />
    <script src="/assets/js/site.js" is:inline></script>
  </body>
</html>
